#!/bin/sh
#
# Gradle start-up script. If the wrapper JAR is missing (e.g. the project was
# generated by hand), fetch the small wrapper JAR from Maven Central first.
# Android Studio regenerates this automatically when the project is opened.
#
set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$JAR" ]; then
  echo "Downloading gradle-wrapper.jar ..." >&2
  curl -fsSL --retry 3 \
    -o "$JAR" \
    "https://raw.githubusercontent.com/gradle/gradle/v8.9.0/gradle/wrapper/gradle-wrapper.jar" \
    || {
      echo "Could not download gradle-wrapper.jar. Open the project in Android Studio instead." >&2
      exit 1
    }
fi

exec java -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
